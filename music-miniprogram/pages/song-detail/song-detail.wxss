/* pages/song-detail/song-detail.wxss */
.hero {
  position: relative;
  width: 100%;
  height: 500rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.cover {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 60rpx 32rpx 24rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
}

.song-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.song-artist {
  display: block;
  font-size: 26rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: #1a1a2e;
  border-radius: 16rpx;
}

.action-icon {
  font-size: 48rpx;
}

.action-icon.play {
  font-size: 56rpx;
}

.action-label {
  font-size: 22rpx;
  color: #888;
  margin-top: 8rpx;
}

.info-card {
  background: #1a1a2e;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 32rpx;
}

.info-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #888;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #e0e0e0;
}

.info-value.desc {
  line-height: 1.6;
}

.section {
  margin-top: 16rpx;
}
