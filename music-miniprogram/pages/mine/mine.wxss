/* pages/mine/mine.wxss */
.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border-radius: 20rpx;
  margin-bottom: 32rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #333;
  border: 4rpx solid #e94560;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 60rpx;
}

.user-info {
  flex: 1;
  margin-left: 28rpx;
  overflow: hidden;
}

.nickname {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.username {
  display: block;
  font-size: 24rpx;
  color: #888899;
  margin-top: 6rpx;
}

.stats {
  display: flex;
  gap: 40rpx;
  margin-top: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #e94560;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #888899;
}

.login-btn {
  margin-top: 20rpx;
  padding: 0 32rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: #e94560;
  color: #fff;
  font-size: 26rpx;
  border-radius: 30rpx;
  border: none;
  display: inline-block;
}

.login-btn::after {
  border: none;
}

.menu-card {
  background: #1a1a2e;
  border-radius: 16rpx;
  margin-top: 32rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #e0e0e0;
}

.menu-arrow {
  font-size: 32rpx;
  color: #666;
}

.empty {
  text-align: center;
  padding: 40rpx 0;
  color: #666;
  font-size: 26rpx;
}
