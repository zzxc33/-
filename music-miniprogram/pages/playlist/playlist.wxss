/* pages/playlist/playlist.wxss */
.playlist-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.playlist-item {
  width: calc((100% - 20rpx) / 2);
}

.playlist-cover {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #1a1a2e;
}

.cover-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.play-overlay {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: rgba(233, 69, 96, 0.9);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}

.playlist-name {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.playlist-meta {
  display: block;
  font-size: 22rpx;
  color: #888899;
}
